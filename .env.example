APP_ENV=development
DEBUG=true
APP_TITLE=Keel
PROJECT_NAME=keel
APP_DESCRIPTION=FastAPI scaffold with SQLAlchemy and RBAC

SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=240
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database: postgresql+asyncpg://user:pass@host:5432/db
# Local/dev fallback: sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/keel
TABLE_PREFIX=keel_

REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

CORS_ORIGINS=http://localhost:3000,http://localhost:8080

SWAGGER_UI_USERNAME=admin
SWAGGER_UI_PASSWORD=change-me-swagger

# Bootstrap superuser (created on first startup if missing)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=AdminPass123
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Set true to skip auth dependencies (local debug only)
DISABLE_AUTH=false
